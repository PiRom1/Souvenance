# Copier en .env et remplir. Le .env n'est jamais commité.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changer-moi
SOUVENANCE_DEBUG=false

# Déploiement (docker compose) : domaine servi par Traefik
DOMAIN=souvenance.duckdns.org
